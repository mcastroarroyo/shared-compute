{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared-compute.dev/protocol/v0/common.json",
  "title": "Common definitions (protocol v0)",
  "$defs": {
    "uuid": {
      "type": "string",
      "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "b64": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]*={0,2}$",
      "minLength": 1
    },
    "unixSeconds": { "type": "integer", "minimum": 0 },
    "platform": { "enum": ["macos", "linux", "windows", "android", "ios"] },
    "arch": { "enum": ["arm64", "x86_64"] },
    "backend": { "enum": ["metal", "cuda", "rocm", "vulkan", "opencl", "sycl", "cpu"] },
    "hardwareClass": {
      "enum": ["MICRO", "SMALL", "MEDIUM", "LARGE", "XL", "CONFIDENTIAL_GPU"]
    },
    "trustTier": { "enum": ["community", "device_attested", "confidential"] },
    "thermalState": { "enum": ["nominal", "fair", "serious", "critical"] },
    "networkKind": { "enum": ["wifi", "ethernet", "cellular", "unknown"] },
    "finishReason": { "enum": ["stop", "length", "cancel", "error"] },

    "securityCapabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "hardware_key": { "type": "boolean" },
        "secure_boot": { "type": "boolean" },
        "measured_boot": { "type": "boolean" },
        "runtime_attested": { "type": "boolean" },
        "confidential_memory": { "type": "boolean" },
        "confidential_gpu": { "type": "boolean" }
      },
      "required": [
        "hardware_key", "secure_boot", "measured_boot",
        "runtime_attested", "confidential_memory", "confidential_gpu"
      ]
    },

    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "platform": { "$ref": "common.json#/$defs/platform" },
        "arch": { "$ref": "common.json#/$defs/arch" },
        "cpu": { "type": "string", "maxLength": 128 },
        "gpu": { "type": "string", "maxLength": 128 },
        "ram_mb": { "type": "integer", "minimum": 0 },
        "vram_mb": { "type": "integer", "minimum": 0 },
        "backend": { "$ref": "common.json#/$defs/backend" },
        "hardware_class": { "$ref": "common.json#/$defs/hardwareClass" },
        "max_context": { "type": "integer", "minimum": 0 },
        "models": {
          "type": "array",
          "items": { "type": "string", "maxLength": 128 },
          "maxItems": 256
        },
        "security_capabilities": { "$ref": "common.json#/$defs/securityCapabilities" }
      },
      "required": [
        "platform", "arch", "ram_mb", "backend", "hardware_class",
        "max_context", "models", "security_capabilities"
      ]
    },

    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "active_jobs": { "type": "integer", "minimum": 0 },
        "queue_depth": { "type": "integer", "minimum": 0 },
        "cpu_load": { "type": "number", "minimum": 0, "maximum": 1 },
        "mem_available_mb": { "type": "integer", "minimum": 0 },
        "thermal_state": { "$ref": "common.json#/$defs/thermalState" },
        "battery_pct": { "type": ["integer", "null"], "minimum": 0, "maximum": 100 },
        "charging": { "type": ["boolean", "null"] },
        "network": { "$ref": "common.json#/$defs/networkKind" }
      },
      "required": ["active_jobs", "queue_depth", "cpu_load", "mem_available_mb", "thermal_state"]
    },

    "usage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "prompt_tokens": { "type": "integer", "minimum": 0 },
        "completion_tokens": { "type": "integer", "minimum": 0 },
        "total_tokens": { "type": "integer", "minimum": 0 }
      },
      "required": ["prompt_tokens", "completion_tokens", "total_tokens"]
    },

    "samplingParams": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_tokens": { "type": "integer", "minimum": 1, "maximum": 131072 },
        "temperature": { "type": "number", "minimum": 0, "maximum": 2 },
        "top_p": { "type": "number", "minimum": 0, "maximum": 1 },
        "top_k": { "type": "integer", "minimum": 0 },
        "repeat_penalty": { "type": "number", "minimum": 0, "maximum": 4 },
        "stop": { "type": "array", "items": { "type": "string" }, "maxItems": 8 },
        "seed": { "type": ["integer", "null"] }
      },
      "required": ["max_tokens"]
    },

    "chatMessage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "role": { "enum": ["system", "user", "assistant", "tool"] },
        "content": { "type": "string" }
      },
      "required": ["role", "content"]
    },

    "attestation": {
      "type": "object",
      "description": "Opaque, tier-specific attestation evidence. Verified by the coordinator's policy engine. v0 accepts an empty object (Tier 0).",
      "properties": {
        "kind": { "enum": ["none", "android_key", "play_integrity", "tpm", "vbs_enclave", "avf", "nvidia_cc", "sev_snp", "tdx"] },
        "evidence": { "type": "object" }
      },
      "required": ["kind"]
    }
  }
}
