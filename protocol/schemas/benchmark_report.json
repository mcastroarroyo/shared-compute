{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shared-compute.dev/protocol/v0/benchmark_report.json",
  "title": "benchmark_report (provider -> coordinator)",
  "type": "object",
  "properties": {
    "type": { "const": "benchmark_report" },
    "model": { "type": "string", "maxLength": 128 },
    "backend": { "$ref": "common.json#/$defs/backend" },
    "prefill_tps": { "type": "number", "minimum": 0 },
    "decode_tps": { "type": "number", "minimum": 0 },
    "context_tested": { "type": "integer", "minimum": 1 },
    "sample_ms": { "type": "integer", "minimum": 0 },

    "sustained_seconds": { "type": "integer", "minimum": 0 },
    "sustained_start_tps": { "type": "number", "minimum": 0 },
    "sustained_end_tps": { "type": "number", "minimum": 0 },
    "mem_bandwidth_gbps": { "type": "number", "minimum": 0 },
    "available_ram_mb": { "type": "integer", "minimum": 0 },
    "available_storage_mb": { "type": "integer", "minimum": 0 },
    "cpu_cores": { "type": "integer", "minimum": 0 },
    "thermal_state": { "type": "string", "maxLength": 32 }
  },
  "required": ["type", "model", "backend", "prefill_tps", "decode_tps"]
}
